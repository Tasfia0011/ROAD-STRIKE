def trigger_game_over():
    global game_over, view_mode, player_fly_x, player_fly_y, player_fly_z, player_fly_angle, camera_angle, accident_x
    if not game_over:
        game_over = True
        view_mode = 1
        player_fly_x = bike_pos_x
        player_fly_y = 0.0
        player_fly_z = 90.0
        player_fly_angle = 0.0
        camera_angle = 0.0
        accident_x = bike_pos_x

